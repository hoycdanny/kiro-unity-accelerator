            { "typeName": "UnityEngine.Rendering.Volume", "properties": {} }
          ],
          "children": [],
          "mcpTool": "manage_gameobject",
          "mcpArgs": { "action": "create", "name": "Skybox" }
        }
      ],
      "mcpTool": "manage_gameobject",
      "mcpArgs": { "action": "create", "name": "---Environment---" }
    },
    {
      "name": "---Player---",
      "components": [],
