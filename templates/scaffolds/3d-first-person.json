              "mcpArgs": { "action": "create_camera", "properties": { "name": "MainCamera" } },
              "note": "manage_camera has no parent/tag param — reparent and tag this object afterward via manage_gameobject(action: 'modify', target: 'MainCamera', parent: 'FPSController', tag: 'MainCamera')"
            }
          ],
          "mcpTool": "manage_gameobject",
          "mcpArgs": { "action": "create", "name": "FPSController", "tag": "Player" }
